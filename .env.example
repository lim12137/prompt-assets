# GHCR owner, must match the owner used in .github/workflows/publish-images.yml
GHCR_OWNER=your-github-owner

# Image tags published by GitHub Actions
WEB_IMAGE_TAG=latest
POSTGRES_IMAGE_TAG=16-alpine

# Runtime ports
WEB_PORT=13000
POSTGRES_PORT=5432

# Database bootstrapping
POSTGRES_DB=prompt_management
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Web runtime env
APP_BASE_URL=http://localhost:13000

# ---------------------------------------------------------------------------
# 登录配置（旧 OA 登录，保留作回退）
# ---------------------------------------------------------------------------
# OA（有度一体化）门户地址
AWS_PORTAL_URL=http://<oa-host>:<port>
# 本系统 token 签名密钥（强随机，不入库；变更会导致所有会话失效）
LOGIN_TOKEN_SECRET=<strong-random-secret>
# 旧登录 RSA 加密参数（前端 RSA 加密提交用，未落地可留默认）
RSA_MODULUS_HEX=<rsa-modulus-hex>
RSA_EXPONENT=65537
# 白名单 / 管理权限
WHITELIST_ENABLED=false
WHITELIST_DEFAULT_IDS=
WHITELIST_DEFAULT_NAMES=
WHITELIST_ADMIN_USER_IDS=
WHITELIST_ADMIN_USER_NAMES=
# Cookie / token TTL
LOGIN_COOKIE_NAME=auth_token
LOGIN_TOKEN_TTL_MINUTES=120
# LOGIN_COOKIE_SECURE: auto（生产自动 Secure）| true | false
LOGIN_COOKIE_SECURE=auto
# 是否所有登录用户都给管理权限（仅调试用，生产保持 false）
ALLOW_ALL_LOGIN_USERS_MANAGE=false

# ---------------------------------------------------------------------------
# SSO 统一认证配置（方案 A：Authorization Code + PKCE + 机密客户端）
# ---------------------------------------------------------------------------
# SSO 总开关；false 时 /api/auth/sso/* 返回 404，前端隐藏 SSO 入口
AGENT_UI_SSO_ENABLED=false
# client 凭据（找 SSO 管理员申请；CLIENT_SECRET 绝不入库）
AGENT_UI_SSO_CLIENT_ID=<找 SSO 管理员申请>
AGENT_UI_SSO_CLIENT_SECRET=<找 SSO 管理员申请，不入库>
# 后端 callback 绝对地址（必须和 SSO 后台 redirect_uri 白名单精确一致）
AGENT_UI_SSO_REDIRECT_URI=http://<app-host>:<port>/api/auth/sso/callback
# SSO origin（服务端直连，不进浏览器）
AGENT_UI_SSO_SSO_ORIGIN=http://<sso-host>:<sso-port>
# 各端点（默认拼在 /auth/oauth2/* 与 /system/user/getInfo，按平台确认 path 前缀）
AGENT_UI_SSO_AUTHORIZE_URL=http://<sso-host>:<sso-port>/auth/oauth2/authorize
AGENT_UI_SSO_TOKEN_URL=http://<sso-host>:<sso-port>/auth/oauth2/token
AGENT_UI_SSO_PROFILE_URL=http://<sso-host>:<sso-port>/system/user/getInfo
AGENT_UI_SSO_JWKS_URL=http://<sso-host>:<sso-port>/auth/oauth2/jwks
AGENT_UI_SSO_ISSUER=http://<sso-host>:<sso-port>/auth
AGENT_UI_SSO_LOGOUT_URL=http://<sso-host>:<sso-port>/auth/oauth2/session/logout/all
# scope 与 state TTL
AGENT_UI_SSO_SCOPE=openid profile
AGENT_UI_SSO_STATE_TTL_SECONDS=300
# 前端回跳基址（不写死端口；callback success/failure 由它推导）
AGENT_UI_FRONTEND_BASE_URL=http://<app-host>:<port>
# 旧账号密码登录入口是否在登录页可见（默认隐藏，开发可置 true）
AGENT_UI_LEGACY_LOGIN_VISIBLE=false

# Home AI tools
AI_TOOLS=ceic-chat,chatgpt,claude
AI_TOOL_CEIC_CHAT_NAME=CEIC Chat
AI_TOOL_CEIC_CHAT_ICON=ceic
AI_TOOL_CEIC_CHAT_ORDER=10
AI_TOOL_CEIC_CHAT_URL=https://chat.ceic.com
AI_TOOL_CEIC_CHAT_DESC=企业内对话入口
AI_TOOL_CEIC_CHAT_ACCENT_COLOR=#d92d20
AI_TOOL_CEIC_CHAT_ICON_BACKGROUND=#fde8e7
AI_TOOL_CHATGPT_NAME=ChatGPT
AI_TOOL_CHATGPT_ICON=chatgpt
AI_TOOL_CHATGPT_ORDER=20
AI_TOOL_CHATGPT_URL=https://chatgpt.com
AI_TOOL_CHATGPT_DESC=通用问答与写作
AI_TOOL_CHATGPT_ACCENT_COLOR=#f97316
AI_TOOL_CHATGPT_ICON_BACKGROUND=#fff4e8
AI_TOOL_CLAUDE_NAME=Claude
AI_TOOL_CLAUDE_ICON=claude
AI_TOOL_CLAUDE_ORDER=30
AI_TOOL_CLAUDE_URL=https://claude.ai
AI_TOOL_CLAUDE_DESC=长文本与分析辅助
AI_TOOL_CLAUDE_ACCENT_COLOR=#7c4a2d
AI_TOOL_CLAUDE_ICON_BACKGROUND=#f5efe9
